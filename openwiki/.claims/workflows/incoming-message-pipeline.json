    {
      "id": "claim_04adb057cbe942a996dce67073038a53",
      "statement": "IncomingMessageDispatcher.dispatch is the single fan-out point for all inbound SMS and MMS and applies a fixed order: (1) mirror into Room via TelephonySyncCoordinator.mutate(Upsert), (2) blocklist gate, (3) address-cache invalidation, (4) SmsEventBus.emitSms, (5) WebhookEngine.sendIncomingSmsWebhook, (6) notification; its contract is that sms.id and sms.threadId must come from the provider row just written or read back, so every consumer reacts to provider state, not optimistic local state.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/receiver/IncomingMessageDispatcher.kt#L43-L79",
          "version": "repo-lines-v1:sha256:9fd276bd82d81fde37942d1488f79047a148ca56b714c60325b5f8513e0b36b2:"
        }
      ]
    },
    {
      "id": "claim_ea490bc33cf248328aca5df6d4ed530b",
      "statement": "Messages from blocked senders short-circuit after the unconditional Room mirror: dispatch returns immediately with no bus event, no webhook, and no notification while the row stays persisted in both the provider and the Room shadow — blocking is a notification policy, not a sync policy; the static BlocklistRepository.isBlocked shortcut exists so broadcast receivers can check without instance state.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/receiver/IncomingMessageDispatcher.kt#L48-L58",
          "version": "repo-lines-v1:sha256:d5509a28730d7980687a4827df3df47ce6d1e9619f715ececa9b54047fdfc535:"
