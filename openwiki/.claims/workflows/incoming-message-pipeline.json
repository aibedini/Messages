  "claims": [
    {
      "id": "claim_f60d229a22284f50a2fa3d50dcb7a4de",
      "statement": "Every inbound receiver follows the single-source-of-truth ordering: the message is persisted into the Telephony provider first (SmsReceiver INSERTs into Telephony.Sms.Inbox on the default-app path), the row is then read back by id, and IncomingMessageDispatcher.dispatch is called only with the provider-confirmed Sms; a read-back failure degrades to a fallback model built from the broadcast (id set to the PDU timestamp) and delivery continues.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/receiver/IncomingMessageDispatcher.kt#L36-L47",
          "version": "repo-lines-v1:sha256:5461700cc78b1e102f7884e2459d396a78fe79b7ca783331542224eff3bcecaa:"
        },
