    {
      "id": "claim_c6378cab403f442981181694d5aebcf8",
      "statement": "TelephonySyncCoordinator is the single writer into Room; its exact-mutation channel is UNLIMITED and never conflated (a bounded channel would silently drop events under a burst), and an Upsert mutation runs one Room transaction that upserts the MessageEntity keyed by (source, providerId), computes the conversation unread count as an O(1) signed delta via UnreadDelta (new unread +1, re-upsert 0, unread-to-read -1), and upserts the conversation projection with upsertPreservingFlags — a true upsert, so a brand-new thread is INSERTed on the realtime path without a later rebuild.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/data/TelephonySyncCoordinator.kt#L143-L181",
          "version": "repo-lines-v1:sha256:8952dd5f4101983508b6d9df3e13ac770ff723cd940a5e25c6a58ae8e445f81a:"
        },
