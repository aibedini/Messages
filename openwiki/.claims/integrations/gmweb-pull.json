          "version": "repo-lines-v1:sha256:5e817e2b29296dc900938df6c8d6f988931b2d6fb91cfbe8c3b07ac4bdbe1fc3:"
        }
      ]
    },
    {
      "id": "claim_278a35715a934387a03e20a92dde190a",
      "statement": "ConnectionSupervisor owns the poller lifecycle: reconcile() calls components.startPoller() only when gmwebUrl is non-blank, the disabled and offline paths call stopPoller(), and shutdown() stops it; GatewayService wires OutboxPoller's start/stop into the supervisor's ManagedComponents.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/ConnectionSupervisor.kt#L167-L178",
          "version": "repo-lines-v1:sha256:e2dc361674cd031ddd666976f22e27f9575005de2ad2f44f6945f618d8265b20:"
