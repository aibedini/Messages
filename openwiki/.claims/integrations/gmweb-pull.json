          "version": "repo-lines-v1:sha256:4eb2b9fbfe7f34ebc64fd6cbe57969cd609fbf6a04333557aba901bab23d9943:"
        }
      ]
    },
    {
      "id": "claim_e19a930585ad4e25a418fcfde5b3a8be",
      "statement": "Because the queue's sender lambda is { to, text -> smsSender.sendForResult(to, text) != null } (installed by GatewayServer.start), a modem/SIM rejection returns a real false, the record becomes FAILED, and the ack reports device_send_failed — the same radio-level honesty the LAN path provides.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/GatewayServer.kt#L111-L112",
          "version": "repo-lines-v1:sha256:903e9380f41737a89de62d8d3b0eedf0ced4c34f7413eebdb39ff14aab339e92:"
        },
