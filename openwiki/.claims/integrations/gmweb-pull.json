          "version": "repo-lines-v1:sha256:6b4ef8dd0b632752e54ac132d20ccaa2a46e55557041e49aac509f863d12c6bb:"
        },
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/GatewayService.kt#L136-L170",
