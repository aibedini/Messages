        }
      ]
    },
    {
      "id": "claim_d784da76262a414088a2dd9ff60533d3",
      "statement": "A polled task is delivered through the same EveSmsQueue used by the LAN /send endpoint — enqueued with a null idempotency key (the server already de-duplicates), unknown priority defaulting to announcement — then drained until the record reaches a terminal status within a 120s deadline via drainUntilTerminal, which drives drainOne and polls status.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/eve/EveSmsQueue.kt#L233-L261",
          "version": "repo-lines-v1:sha256:d054cc853ebf7ad8ec7b8f54b93d822e9abcbf4b2de0c0adceb21d791ab143b8:"
        },
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/OutboxPoller.kt#L143-L154",
          "version": "repo-lines-v1:sha256:b71e046cb0880fc18dd9f0c4d56d617c0d7f0df378e6cae2517f6a75afcbffcb:"
        },
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/OutboxPoller.kt#L174-L188",
          "version": "repo-lines-v1:sha256:2cfc6477c1b8dd12dd8fa2a7dc6caf69a13f9e1cfef8674ee01cfcd2d8d23acf:"
        }
      ]
    },
    {
      "id": "claim_c425c76d3f0d4b0fbeed046263c14ac5",
      "statement": "The ack reports ok=true on success or ok=false with reason device_send_failed on delivery failure/timeout, and a lost ack is deliberately not re-sent locally — the GMweb server times the task out and owns the retry, so the phone must never re-send.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/OutboxPoller.kt#L151-L153",
          "version": "repo-lines-v1:sha256:38dd02e83ee5ecb031395a40451caf24a4af257a4e568cf470b9f67e07a1ed9b:"
        },
        {
