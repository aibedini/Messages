    {
      "id": "claim_278a35715a934387a03e20a92dde190a",
      "statement": "ConnectionSupervisor owns the poller lifecycle: reconcile() calls components.startPoller() only when gmwebUrl is non-blank (a blank URL means the poller is never started at all), both the disabled (desired-off/no-consent) and offline (WAITING_FOR_NETWORK) reconcile paths call stopPoller(), and shutdown() stops it on service teardown; GatewayService wires OutboxPoller's start/stop into the supervisor's ManagedComponents.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/ConnectionSupervisor.kt#L173-L186",
          "version": "repo-lines-v1:sha256:e227c45cb784c960250a432c465d6ca4a296c28dc28943d3e88c0c6bba7a0b40:"
