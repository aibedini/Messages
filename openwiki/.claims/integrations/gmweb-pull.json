          "version": "repo-lines-v1:sha256:a4f745cba1cee2875b95effb499f28ef7d9815452e10f212d81e72c405e89e1c:"
        }
      ]
    },
    {
      "id": "claim_2ce47ae383c9470aa682e8224f5d098e",
      "statement": "The bridge is active whenever GatewayPreferences.gmwebUrl is non-blank; the setter requires an https:// prefix (rejecting plaintext) and treats an empty value as 'bridge disabled', while the LAN and cloud features keep working regardless.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/ConnectionSupervisor.kt#L269-L269",
          "version": "repo-lines-v1:sha256:d8e14eaafa9bdd95709f87d87e4567f5c58fb01bd5747aa4cd3f7414576f1fe1:"
