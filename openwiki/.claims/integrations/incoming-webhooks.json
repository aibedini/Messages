    {
      "id": "claim_e672e19d96e64db9b701204e1d9f3d45",
      "statement": "The idempotency cache stores acknowledged event IDs as a JSON array under the cloud_sent_event_ids SharedPreferences key, capped at 500 entries (MAX_EVENT_IDS) in insertion order with oldest-first FIFO trimming; markEventSent removes any existing occurrence and re-inserts at the tail, and a corrupt stored value is read back as an empty list so a damaged store degrades to backend-side dedupe rather than blocking uploads.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/GatewayPreferences.kt#L259-L280",
