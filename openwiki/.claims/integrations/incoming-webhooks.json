    {
      "id": "claim_ef6f62885ca94397becb6645dd53c591",
      "statement": "The cloud event upload (sendCloudEvent) runs only when prefs.isRegistered is true and the Keystore-stored gatewayToken is non-blank; an unregistered or token-less phone silently skips the cloud leg while the local webhook leg is unaffected.",
      "evidence": [
