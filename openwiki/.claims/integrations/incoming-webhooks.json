    {
      "id": "claim_357ab6eb84274e58b9bb17a02db61499",
      "statement": "BackendClient.post re-checks that the backend URL starts with https:// before opening any connection (returning Failure 'Insecure backend URL rejected — HTTPS required'), sends Authorization: Bearer <gatewayToken> when authenticated and the token is non-blank, uses 15s connect / 30s read timeouts, and returns a sealed Result<T> (no exceptions leak) with HTTP 401/403 classified as Failure(isAuthError = true).",
