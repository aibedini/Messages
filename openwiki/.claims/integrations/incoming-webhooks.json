    {
      "id": "claim_dc7480e16a3140318e0ce427f7d04b7e",
      "statement": "Unlike GatewayPreferences.backendUrl (whose setter requires https:// and throws on plaintext), the webhookUrl setter performs no scheme check, so a non-HTTPS webhook URL can be saved from the UI but is rejected on every dispatch attempt.",
      "evidence": [
