    {
      "id": "claim_706d37887a65452d841ed3ac4a2e8c84",
      "statement": "The local webhook request is a JSON POST with Content-Type application/json; charset=utf-8, User-Agent Android-SMS-Gateway/<APP_VERSION>, and 8-second connect and 8-second read timeouts.",
