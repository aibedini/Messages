    {
      "id": "claim_29f81b1e810141abb2352b43e3505c8a",
      "statement": "When the user-configured webhook signing secret is non-blank, the request carries X-Timestamp (System.currentTimeMillis() as a string) and X-Signature = lowercase hex(HMAC_SHA256(secret, '<X-Timestamp>.<raw-body>')) computed with javax.crypto.Mac over the exact serialized JSON bytes that are POSTed; the timestamp in the signed string enables replay rejection, and docs/api instructs receivers to compare in constant time and reject stale timestamps; with a blank secret the request is sent unsigned with no X-* headers.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/WebhookEngine.kt#L73-L97",
          "version": "repo-lines-v1:sha256:6344bd0477ea4a4be2f5a391156afa2757d329735615ee03ab120e1a02e997c4:"
