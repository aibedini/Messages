    {
      "id": "claim_596c4d39ea354eaabf1648dedbfe6e82",
      "statement": "The local webhook URL must start with https://: at dispatch time a non-HTTPS trimmed URL is logged ('Webhook URL rejected — HTTPS required') and never POSTed; a blank URL simply means no local dispatch.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/gateway/WebhookEngine.kt#L36-L43",
          "version": "repo-lines-v1:sha256:5a2def4d0ea630519ddcf7a7c6a17c9cc3ccda48518b6cd6264b32c6820f4726:"
        }
