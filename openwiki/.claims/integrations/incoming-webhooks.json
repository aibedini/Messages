    {
      "id": "claim_a3338104cfb5424e904a7bd6b3666672",
      "statement": "The cloud event is POSTed as { eventId, type: \"sms.received\", sender, message, timestamp } to POST {backend}/api/gateways/events/sms through BackendClient with Bearer authentication; the payload differs from the local webhook body (eventId/type instead of event/threadId).",
      "evidence": [
