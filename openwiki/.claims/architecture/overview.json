    {
      "id": "claim_5e7700d74ab64d45a2312d4d80f97cc3",
      "statement": "ChangeRouter converts content-observer notifications into the cheapest shadow update: when the change URI carries an extractable row id it performs a targeted O(1) provider read and mutate (or Delete when the row vanished), and id-less URIs fall back to reconcile, first consulting the LocalProviderWrites hint registry to downgrade a self-caused mark-read to a ForThread repair; all provider I/O is offloaded off the main looper.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/data/ChangeRouter.kt#L45-L109",
          "version": "repo-lines-v1:sha256:3faf276a4eead5caf2aaf99ae2113ad61aee4513bd0c6a0b35169242015e37c2:"
