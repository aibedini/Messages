          "version": "repo-lines-v1:sha256:35687dfdca9e469ef0515850962d5d0ef6ccbc228cff2bdefe8152d08310c7cf:"
        }
      ]
    },
    {
      "id": "claim_45ca76a1bba344269265b1a99d8fa1ac",
      "statement": "SMS_DELIVER fires only when the app is the default SMS app while SMS_RECEIVED fires for all apps; when default, SmsReceiver skips SMS_RECEIVED for a PDU already owned by SMS_DELIVER and itself inserts the message into Telephony.Sms.Inbox, whereas as a non-default app only SMS_RECEIVED arrives and the system default app's written row is picked up by the app's content observer.",
      "evidence": [
        {
          "resource": "repo://app/src/main/AndroidManifest.xml#L79-L93",
          "version": "repo-lines-v1:sha256:ea19ef93108608ef305f2314654fffce595512479afec51d940d14e8cb0316c3:"
