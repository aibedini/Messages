  "claims": [
    {
      "id": "claim_b964b5579d184f6394a8369e01f591d4",
      "statement": "The manifest declares the default-SMS-app component contract: an exported SmsReceiver with BROADCAST_SMS and priority-999 filters for both SMS_RECEIVED and SMS_DELIVER, mmslib's PushReceiver and TransactionService for WAP-push MMS, and HeadlessSmsSendService as the required RESPOND_VIA_MESSAGE service; the app gates this behavior on holding the default-SMS role (RoleManager.ROLE_SMS on API 29+, otherwise Telephony.Sms.getDefaultSmsPackage), which MainActivity requests through the system role intent during onboarding.",
      "evidence": [
        {
          "resource": "repo://app/src/main/AndroidManifest.xml#L83-L163",
          "version": "repo-lines-v1:sha256:17fad1650720c1394367e03b20091628a5fdf27304469e1d87115374a9f60c60:"
        },
        {
