    {
      "id": "claim_68da31d5dc7f4d2989412d1c7ef4deab",
      "statement": "TelephonySyncCoordinator is the single writer into Room with two channels: exact mutations (Upsert/Delete/RefreshStatus/MarkThreadRead/DeleteThread) processed sequentially without conflation, each Upsert applying message row plus conversation projection in one Room transaction with an O(1) unread delta, while reconcile requests (FullSync/ForThread) are conflated so many nudges collapse into one bounded repair pass.",
      "evidence": [
        {
          "resource": "repo://app/src/main/java/com/autonomousone/messages/data/MessageMutation.kt",
          "version": "repo-file-v1:sha256:c8f4c1669bd9366ecc81400d2faa764a35b88681d96544624de4976645652cd1"
